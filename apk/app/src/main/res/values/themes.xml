<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light base theme: the setup screen, settings dialog and error
         screen render light; the accent drives the EditText cursor. -->
    <style name="Theme.DshRemote" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:colorAccent">#4176E6</item>
        <!-- Android 15+ enforces edge-to-edge for targetSdk 35: the WebView
             would draw under the status bar / camera punch-hole. Opt out so
             content starts below the status bar. -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
