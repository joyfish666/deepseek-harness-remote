# remote-gateway 配置（复制为 .env 并填写）
# 本文件仅作模板；真实 .env 已被 .gitignore 排除，不会上传。

# 网关监听端口（仅本机回环地址，对外由 Tailscale Serve 转发）
GATEWAY_PORT=3100

# 访问令牌：手机端首次使用时输入。
# 生成方式：node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
GATEWAY_TOKEN=change-me

# 本机 dsh Web 服务地址（保持默认）
DSH_URL=http://127.0.0.1:3080
